# Application environment configuration
# Copy this file to .env and fill in values as needed.

# SQLite database URL (default resolves to backend/meeting.db)
DATABASE_URL=sqlite:///meeting.db

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Hugging Face Inference Providers Configuration (Server-Side Only)
# Store actual token in backend/.env or server environment variables. Never expose in frontend!
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct-1M
